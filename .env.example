# ScreenMind Configuration
# Copy this to .env and adjust as needed

# Capture Settings
CAPTURE_INTERVAL=30
SCREENSHOT_QUALITY=70
DATA_DIR=~/.screenmind

# Model Settings (local-only - no cloud inference)
# ScreenMind runs 100% locally via llama-server. The legacy GEMMA_MODE "api"
# mode and GOOGLE_API_KEY have been removed; GEMMA_MODE is hard-locked to
# "local" and any other value is ignored with a warning.
GEMMA_MODE=local

# llama-server (local inference)
# NOTE: Do NOT set port in both LLAMA_SERVER_HOST and LLAMA_SERVER_PORT — they will silently diverge.
# LLAMA_SERVER_HOST=http://127.0.0.1:5809
# LLAMA_SERVER_PORT=5809

# Developer Context
WORKSPACE_DIRS=~/Projects,~/Desktop

# Privacy
BLOCKED_APPS=

# Hotkey
BOOKMARK_HOTKEY=ctrl+shift+b
